{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roblox-studio-axi.local/schemas/workflow.schema.json",
  "title": "Roblox Studio AXI workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "tests", "cleanup"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {
        "include": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fail_fast": { "type": "boolean" },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screenshots": { "enum": ["always", "on_failure", "never"] },
        "console": { "enum": ["all", "errors_and_warnings", "errors"] }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stop_playtest"],
      "properties": { "stop_playtest": { "const": true } }
    }
  }
}
